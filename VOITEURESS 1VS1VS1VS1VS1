<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<title>سباق السيارات ثلاثي الأبعاد - 4 لاعبين - 50 مستوى</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html, body { width:100%; height:100%; overflow:hidden; background:#0a0a12; font-family: 'Segoe UI', Tahoma, sans-serif; }
  #gameCanvas { display:block; width:100vw; height:100vh; }

  /* ===== Split screen HUD ===== */
  #hud { position:fixed; inset:0; pointer-events:none; z-index:10; }
  .hudPanel {
    position:absolute; width:50%; height:50%; padding:10px 16px;
    color:#fff; text-shadow: 0 2px 4px rgba(0,0,0,.9);
    font-weight:bold; font-size:15px;
  }
  #hud1 { top:0; left:0; }
  #hud2 { top:0; left:50%; }
  #hud3 { top:50%; left:0; }
  #hud4 { top:50%; left:50%; }
  .hudName { font-size:16px; padding:3px 10px; border-radius:6px; display:inline-block; }
  .hudLine { margin-top:4px; font-size:13px; opacity:.9; }

  /* divider lines between quadrants */
  #hud::before, #hud::after {
    content:''; position:absolute; background:rgba(255,255,255,.25); z-index:11;
  }
  #hud::before { left:50%; top:0; width:2px; height:100%; }
  #hud::after { top:50%; left:0; width:100%; height:2px; }

  #topBar {
    position:fixed; top:0; left:50%; transform:translateX(-50%);
    z-index:20; color:#fff; text-align:center; padding:8px 22px;
    background:rgba(0,0,0,.55); border-radius:0 0 12px 12px; pointer-events:none;
  }
  #topBar .lvl { font-size:20px; font-weight:bold; }
  #topBar .sub { font-size:12px; opacity:.8; }

  /* ===== Overlays ===== */
  .overlay {
    position:fixed; inset:0; z-index:100; display:flex; align-items:center; justify-content:center;
    background:radial-gradient(ellipse at center, rgba(20,20,40,.92), rgba(5,5,10,.97));
    color:#fff; text-align:center; flex-direction:column; gap:18px;
  }
  .hidden { display:none !important; }
  .card {
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.15);
    border-radius:18px; padding:36px 46px; max-width:640px; backdrop-filter: blur(6px);
  }
  h1 { font-size:34px; background:linear-gradient(90deg,#ff5f6d,#ffc371,#4facfe,#00f2fe);
       -webkit-background-clip:text; background-clip:text; color:transparent; margin-bottom:10px; }
  h2 { font-size:26px; margin-bottom:12px; }
  p { line-height:1.9; font-size:14px; opacity:.9; }
  .controlsGrid { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin:18px 0; text-align:right; }
  .controlBox { background:rgba(255,255,255,.07); border-radius:10px; padding:10px 14px; font-size:13px; border-inline-start:5px solid; }
  button {
    cursor:pointer; border:none; border-radius:12px; padding:14px 38px; font-size:18px; font-weight:bold;
    background:linear-gradient(90deg,#ff5f6d,#ffc371); color:#20120a; transition:.15s transform;
    box-shadow:0 6px 18px rgba(255,95,109,.4);
  }
  button:hover { transform:translateY(-2px) scale(1.03); }
  button.secondary { background:linear-gradient(90deg,#4facfe,#00f2fe); color:#04283a; box-shadow:0 6px 18px rgba(79,172,254,.4); }
  .winnerTag { font-size:22px; padding:8px 22px; border-radius:10px; display:inline-block; margin:10px 0; }
  #levelDots { display:flex; flex-wrap:wrap; gap:4px; max-width:520px; justify-content:center; margin-top:6px; }
  #levelDots span { width:9px; height:9px; border-radius:50%; background:rgba(255,255,255,.15); }
  #levelDots span.done { background:#4facfe; }
  #levelDots span.cur { background:#ff5f6d; }
</style>
</head>
<body>

<canvas id="gameCanvas"></canvas>

<!-- HUD -->
<div id="hud">
  <div class="hudPanel" id="hud1">
    <div class="hudName" style="background:#e63946">اللاعب 1 (W A S D)</div>
    <div class="hudLine" id="p1lap">اللفة: 0/0</div>
  </div>
  <div class="hudPanel" id="hud2" style="text-align:left">
    <div class="hudName" style="background:#3a86ff">اللاعب 2 (الأسهم)</div>
    <div class="hudLine" id="p2lap">اللفة: 0/0</div>
  </div>
  <div class="hudPanel" id="hud3">
    <div class="hudName" style="background:#2a9d5c">اللاعب 3 (I J K L)</div>
    <div class="hudLine" id="p3lap">اللفة: 0/0</div>
  </div>
  <div class="hudPanel" id="hud4" style="text-align:left">
    <div class="hudName" style="background:#e9c46a; color:#3a2c00">اللاعب 4 (Numpad 8/4/6/2)</div>
    <div class="hudLine" id="p4lap">اللفة: 0/0</div>
  </div>
</div>

<div id="topBar" class="hidden">
  <div class="lvl">المستوى <span id="lvlNum">1</span> / 50</div>
  <div class="sub" id="lvlSub">3 لفات للفوز</div>
</div>

<!-- Start screen -->
<div class="overlay" id="startScreen">
  <div class="card">
    <h1>🏎️ سباق السيارات - 4 لاعبين</h1>
    <p>تنافسوا في نفس الوقت عبر 50 مستوى متصاعدة الصعوبة. أول من يكمل عدد اللفات المطلوب يفوز بالمستوى وننتقل جميعًا للمستوى التالي!</p>
    <div class="controlsGrid">
      <div class="controlBox" style="border-color:#e63946">🔴 اللاعب 1: W (أمام) A (يسار) S (خلف) D (يمين)</div>
      <div class="controlBox" style="border-color:#3a86ff">🔵 اللاعب 2: الأسهم ↑ ← ↓ →</div>
      <div class="controlBox" style="border-color:#2a9d5c">🟢 اللاعب 3: I (أمام) J (يسار) K (خلف) L (يمين)</div>
      <div class="controlBox" style="border-color:#e9c46a">🟡 اللاعب 4: Numpad 8/4/2/6</div>
    </div>
    <button id="startBtn">ابدأ السباق 🚀</button>
  </div>
</div>

<!-- Level complete screen -->
<div class="overlay hidden" id="levelCompleteScreen">
  <div class="card">
    <h2>🏁 انتهى المستوى <span id="finishedLvl"></span></h2>
    <div class="winnerTag" id="winnerTag"></div>
    <p id="finalScoresText"></p>
    <button id="nextLevelBtn">المستوى التالي ▶</button>
  </div>
</div>

<!-- Game complete screen -->
<div class="overlay hidden" id="gameCompleteScreen">
  <div class="card">
    <h1>🏆 أنهيت جميع الـ 50 مستوى!</h1>
    <div class="winnerTag" id="ultimateWinnerTag"></div>
    <button id="restartBtn">إعادة اللعب من البداية</button>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
/* =========================================================
   إعداد عام
========================================================= */
const canvas = document.getElementById('gameCanvas');
const renderer = new THREE.WebGLRenderer({ canvas, antialias:true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));
renderer.setSize(window.innerWidth, window.innerHeight);
renderer.shadowMap.enabled = true;

const scene = new THREE.Scene();
scene.fog = new THREE.Fog(0x87ceeb, 120, 420);

let level = 1;
const MAX_LEVEL = 50;
let raceOver = false;
let started = false;

/* ===== مولّد أرقام عشوائية بذرة ثابتة لكل مستوى (نتائج متكررة لنفس المستوى) ===== */
function mulberry32(a){
  return function(){
    a |= 0; a = a + 0x6D2B79F5 | 0;
    let t = Math.imul(a ^ a >>> 15, 1 | a);
    t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t;
    return ((t ^ t >>> 14) >>> 0) / 4294967296;
  };
}

/* =========================================================
   إضاءة + سماء + أرضية
========================================================= */
const hemi = new THREE.HemisphereLight(0xbfe3ff, 0x2a3a1a, 0.9);
scene.add(hemi);
const sun = new THREE.DirectionalLight(0xfff3d6, 1.1);
sun.position.set(80,140,60);
sun.castShadow = true;
sun.shadow.mapSize.set(1024,1024);
sun.shadow.camera.left=-150; sun.shadow.camera.right=150;
sun.shadow.camera.top=150; sun.shadow.camera.bottom=-150;
scene.add(sun);

const groundGeo = new THREE.PlaneGeometry(1000,1000);
const groundMat = new THREE.MeshLambertMaterial({ color:0x3f6b2f });
const ground = new THREE.Mesh(groundGeo, groundMat);
ground.rotation.x = -Math.PI/2;
ground.receiveShadow = true;
scene.add(ground);

/* =========================================================
   توليد المضمار (Procedural Track) لكل مستوى
========================================================= */
let trackGroup = new THREE.Group();
let trackPathPoints = [];   // نقاط متساوية المسافة تقريباً على طول المسار (خط الوسط)
let trackWidth = 16;
let lapsRequired = 2;
let obstacles = [];

function clearTrack(){
  scene.remove(trackGroup);
  trackGroup = new THREE.Group();
  obstacles = [];
}

function generateTrack(lvl){
  clearTrack();
  const rand = mulberry32(lvl*7919 + 13);

  const numCtrl = 8 + Math.min(Math.floor(lvl/4), 14); // 8..22 نقطة تحكم
  const baseR = 70;
  const ctrlPoints = [];
  for(let i=0;i<numCtrl;i++){
    const angle = (i/numCtrl)*Math.PI*2;
    const radiusVar = 0.55 + rand()*0.85;
    const wobble = (lvl>2) ? (rand()-0.5) * 26 * Math.min(lvl,32)/32 : 0;
    const r = baseR*radiusVar + wobble;
    ctrlPoints.push(new THREE.Vector3(Math.cos(angle)*r, 0, Math.sin(angle)*r));
  }

  const curve = new THREE.CatmullRomCurve3(ctrlPoints, true, 'catmullrom', 0.55);
  const N = 480;
  trackPathPoints = curve.getSpacedPoints(N);

  trackWidth = Math.max(17 - lvl*0.16, 7.5);
  lapsRequired = 2 + Math.floor(lvl/15); // 2 -> 3 -> 4

  // بناء شريط المضمار (triangle strip)
  const positions = [];
  const colors = [];
  const hue = (lvl*17 % 360)/360;
  const trackColor = new THREE.Color().setHSL(0.0,0.0,0.22);
  const edgeColor = new THREE.Color().setHSL(hue,0.7,0.55);

  for(let i=0;i<trackPathPoints.length;i++){
    const p = trackPathPoints[i];
    const pNext = trackPathPoints[(i+1)%trackPathPoints.length];
    const tangent = new THREE.Vector3().subVectors(pNext,p).normalize();
    const perp = new THREE.Vector3(-tangent.z,0,tangent.x).normalize();
    const half = trackWidth/2;
    const left = new THREE.Vector3().copy(p).addScaledVector(perp, half);
    const right = new THREE.Vector3().copy(p).addScaledVector(perp, -half);
    positions.push(left.x, 0.02, left.z);
    positions.push(right.x, 0.02, right.z);
    colors.push(trackColor.r,trackColor.g,trackColor.b);
    colors.push(trackColor.r,trackColor.g,trackColor.b);
  }
  const indices = [];
  const count = trackPathPoints.length;
  for(let i=0;i<count;i++){
    const a = i*2, b=i*2+1, c=((i+1)%count)*2, d=((i+1)%count)*2+1;
    indices.push(a,c,b,  b,c,d);
  }
  const geo = new THREE.BufferGeometry();
  geo.setAttribute('position', new THREE.Float32BufferAttribute(positions,3));
  geo.setAttribute('color', new THREE.Float32BufferAttribute(colors,3));
  geo.setIndex(indices);
  geo.computeVertexNormals();
  const mat = new THREE.MeshLambertMaterial({ vertexColors:true });
  const trackMesh = new THREE.Mesh(geo, mat);
  trackMesh.receiveShadow = true;
  trackGroup.add(trackMesh);

  // حواف ملونة (rumble strips) بسيطة كخط رفيع
  const edgeGeoL = new THREE.BufferGeometry();
  const edgeGeoR = new THREE.BufferGeometry();
  const leftPts=[], rightPts=[];
  for(let i=0;i<trackPathPoints.length;i++){
    const p = trackPathPoints[i];
    const pNext = trackPathPoints[(i+1)%trackPathPoints.length];
    const tangent = new THREE.Vector3().subVectors(pNext,p).normalize();
    const perp = new THREE.Vector3(-tangent.z,0,tangent.x).normalize();
    const half = trackWidth/2;
    leftPts.push(new THREE.Vector3().copy(p).addScaledVector(perp, half));
    rightPts.push(new THREE.Vector3().copy(p).addScaledVector(perp, -half));
  }
  leftPts.push(leftPts[0]); rightPts.push(rightPts[0]);
  edgeGeoL.setFromPoints(leftPts);
  edgeGeoR.setFromPoints(rightPts);
  const edgeMat = new THREE.LineBasicMaterial({ color: edgeColor, linewidth:2 });
  trackGroup.add(new THREE.Line(edgeGeoL, edgeMat));
  trackGroup.add(new THREE.Line(edgeGeoR, edgeMat));

  // خط البداية/النهاية
  const startP = trackPathPoints[0];
  const startNext = trackPathPoints[1];
  const tangent0 = new THREE.Vector3().subVectors(startNext,startP).normalize();
  const perp0 = new THREE.Vector3(-tangent0.z,0,tangent0.x).normalize();
  const lineGeo = new THREE.PlaneGeometry(trackWidth, 2);
  const lineMat = new THREE.MeshBasicMaterial({ color:0xffffff });
  const lineMesh = new THREE.Mesh(lineGeo, lineMat);
  lineMesh.rotation.x = -Math.PI/2;
  lineMesh.position.copy(startP).add(new THREE.Vector3(0,0.03,0));
  lineMesh.lookAt(startP.clone().add(tangent0));
  lineMesh.rotation.x = -Math.PI/2;
  trackGroup.add(lineMesh);

  // عوائق تبدأ من المستوى 8
  const obstacleCount = Math.max(0, Math.floor((lvl-6)/5));
  for(let o=0;o<obstacleCount;o++){
    const idx = Math.floor(rand()*trackPathPoints.length);
    const p = trackPathPoints[idx];
    const pNext = trackPathPoints[(idx+1)%trackPathPoints.length];
    const tangent = new THREE.Vector3().subVectors(pNext,p).normalize();
    const perp = new THREE.Vector3(-tangent.z,0,tangent.x).normalize();
    const lateral = (rand()-0.5) * (trackWidth*0.6);
    const pos = new THREE.Vector3().copy(p).addScaledVector(perp, lateral);
    const boxGeo = new THREE.BoxGeometry(2.2,2.2,2.2);
    const boxMat = new THREE.MeshLambertMaterial({ color:0xff9900 });
    const box = new THREE.Mesh(boxGeo, boxMat);
    box.position.copy(pos); box.position.y = 1.1;
    box.castShadow = true;
    trackGroup.add(box);
    obstacles.push({ mesh:box, radius:1.6 });
  }

  scene.add(trackGroup);
}

/* =========================================================
   السيارات
========================================================= */
const PLAYER_DEFS = [
  { color:0xe63946, name:'اللاعب 1', keys:{fwd:'KeyW',bwd:'KeyS',left:'KeyA',right:'KeyD'} },
  { color:0x3a86ff, name:'اللاعب 2', keys:{fwd:'ArrowUp',bwd:'ArrowDown',left:'ArrowLeft',right:'ArrowRight'} },
  { color:0x2a9d5c, name:'اللاعب 3', keys:{fwd:'KeyI',bwd:'KeyK',left:'KeyJ',right:'KeyL'} },
  { color:0xe9c46a, name:'اللاعب 4', keys:{fwd:'Numpad8',bwd:'Numpad2',left:'Numpad4',right:'Numpad6'} },
];

function makeCarMesh(color){
  const group = new THREE.Group();
  const bodyGeo = new THREE.BoxGeometry(1.6,0.6,3.2);
  const bodyMat = new THREE.MeshLambertMaterial({ color });
  const body = new THREE.Mesh(bodyGeo, bodyMat);
  body.position.y = 0.55;
  body.castShadow = true;
  group.add(body);

  const cabinGeo = new THREE.BoxGeometry(1.1,0.5,1.4);
  const cabinMat = new THREE.MeshLambertMaterial({ color:0x111111 });
  const cabin = new THREE.Mesh(cabinGeo, cabinMat);
  cabin.position.set(0,0.95,-0.1);
  cabin.castShadow = true;
  group.add(cabin);

  const wheelGeo = new THREE.CylinderGeometry(0.35,0.35,0.35,12);
  const wheelMat = new THREE.MeshLambertMaterial({ color:0x1a1a1a });
  const wheelPositions = [[-0.85,0.35,1.05],[0.85,0.35,1.05],[-0.85,0.35,-1.05],[0.85,0.35,-1.05]];
  wheelPositions.forEach(p=>{
    const w = new THREE.Mesh(wheelGeo, wheelMat);
    w.rotation.z = Math.PI/2;
    w.position.set(p[0],p[1],p[2]);
    w.castShadow = true;
    group.add(w);
  });
  return group;
}

let cars = [];

function createCars(){
  cars.forEach(c=>scene.remove(c.mesh));
  cars = PLAYER_DEFS.map((def,i)=>{
    const mesh = makeCarMesh(def.color);
    scene.add(mesh);
    return {
      def, mesh,
      speed:0, heading:0,
      progressIndex:0, lastProgressIndex:0,
      laps:0, finished:false, finishOrder:0,
      camera: new THREE.PerspectiveCamera(62, 1, 0.1, 500),
    };
  });
}

function placeCarsAtStart(){
  const startP = trackPathPoints[0];
  const nextP = trackPathPoints[1];
  const tangent = new THREE.Vector3().subVectors(nextP,startP).normalize();
  const heading = Math.atan2(tangent.x, tangent.z);
  const perp = new THREE.Vector3(-tangent.z,0,tangent.x).normalize();
  const slotOffsets = [-4.5,-1.5,1.5,4.5];
  cars.forEach((car,i)=>{
    const off = slotOffsets[i];
    const pos = new THREE.Vector3().copy(startP)
      .addScaledVector(perp, off)
      .addScaledVector(tangent, -3 - i*2.2);
    car.mesh.position.set(pos.x, 0, pos.z);
    car.heading = heading;
    car.mesh.rotation.y = heading;
    car.speed = 0;
    car.progressIndex = 0;
    car.lastProgressIndex = 0;
    car.laps = 0;
    car.finished = false;
    car.finishOrder = 0;
  });
}

/* =========================================================
   المدخلات
========================================================= */
const keysDown = {};
window.addEventListener('keydown', e=>{ keysDown[e.code]=true; if(e.code.startsWith('Arrow')||e.code.startsWith('Numpad')) e.preventDefault(); });
window.addEventListener('keyup', e=>{ keysDown[e.code]=false; });

/* =========================================================
   منطق فيزياء السيارة + المسار
========================================================= */
const MAX_SPEED = 0.62;
const ACCEL = 0.018;
const BRAKE = 0.03;
const FRICTION = 0.012;
const TURN_RATE = 0.045;

function nearestTrackIndexNear(pos, startIdx){
  const N = trackPathPoints.length;
  let best = startIdx, bestD = Infinity;
  const range = 25;
  for(let d=-range; d<=range; d++){
    const idx = ((startIdx+d)%N+N)%N;
    const dist = pos.distanceToSquared(trackPathPoints[idx]);
    if(dist<bestD){ bestD=dist; best=idx; }
  }
  return { idx:best, dist:Math.sqrt(bestD) };
}

function updateCar(car){
  if(car.finished) return;
  const k = car.def.keys;
  if(keysDown[k.fwd]) car.speed = Math.min(car.speed+ACCEL, MAX_SPEED);
  else if(keysDown[k.bwd]) car.speed = Math.max(car.speed-BRAKE, -MAX_SPEED*0.5);
  else {
    if(car.speed>0) car.speed = Math.max(0, car.speed-FRICTION);
    else if(car.speed<0) car.speed = Math.min(0, car.speed+FRICTION);
  }

  const turnFactor = Math.min(Math.abs(car.speed)/MAX_SPEED, 1);
  if(keysDown[k.left]) car.heading += TURN_RATE*turnFactor*(car.speed<0?-1:1);
  if(keysDown[k.right]) car.heading -= TURN_RATE*turnFactor*(car.speed<0?-1:1);

  const dx = Math.sin(car.heading)*car.speed;
  const dz = Math.cos(car.heading)*car.speed;
  const newPos = car.mesh.position.clone().add(new THREE.Vector3(dx,0,dz));

  // البقاء داخل حدود المضمار
  const near = nearestTrackIndexNear(newPos, car.progressIndex);
  car.progressIndex = near.idx;
  const half = trackWidth/2;
  if(near.dist > half){
    const overflow = near.dist - half;
    car.speed *= 0.85; // تباطؤ عند الخروج
    const dir = new THREE.Vector3().subVectors(newPos, trackPathPoints[near.idx]).normalize();
    newPos.sub(dir.multiplyScalar(overflow*0.6)); // دفعة ناعمة للداخل
  }

  // اصطدام بالعوائق
  for(const ob of obstacles){
    const d = newPos.distanceTo(ob.mesh.position);
    if(d < ob.radius+1.0){
      car.speed *= 0.3;
      const push = new THREE.Vector3().subVectors(newPos, ob.mesh.position).normalize();
      newPos.copy(ob.mesh.position).addScaledVector(push, ob.radius+1.0);
    }
  }

  car.mesh.position.copy(newPos);
  car.mesh.rotation.y = car.heading;

  // اكتشاف اللفة
  const N = trackPathPoints.length;
  const last = car.lastProgressIndex;
  const cur = car.progressIndex;
  if(last > N*0.75 && cur < N*0.25){
    car.laps++;
    if(car.laps >= lapsRequired && !raceOver){
      car.finished = true;
      raceOver = true;
      onLevelWon(car);
    }
  }
  car.lastProgressIndex = cur;
}

/* =========================================================
   الكاميرات (شاشة مقسمة 4 أقسام)
========================================================= */
function updateCamera(car){
  const camDist = 8, camHeight = 4.2;
  const behind = new THREE.Vector3(
    -Math.sin(car.heading)*camDist,
    camHeight,
    -Math.cos(car.heading)*camDist
  );
  const desired = car.mesh.position.clone().add(behind);
  car.camera.position.lerp(desired, 0.12);
  const lookAt = car.mesh.position.clone().add(new THREE.Vector3(0,1,0));
  car.camera.lookAt(lookAt);
}

/* =========================================================
   HUD تحديث
========================================================= */
const hudLapEls = [document.getElementById('p1lap'),document.getElementById('p2lap'),document.getElementById('p3lap'),document.getElementById('p4lap')];
function updateHUD(){
  cars.forEach((car,i)=>{
    hudLapEls[i].textContent = `اللفة: ${Math.min(car.laps,lapsRequired)}/${lapsRequired}`;
  });
  document.getElementById('lvlNum').textContent = level;
  document.getElementById('lvlSub').textContent = `${lapsRequired} لفات للفوز`;
}

/* =========================================================
   حلقة اللعبة
========================================================= */
function onWindowResize(){
  renderer.setSize(window.innerWidth, window.innerHeight);
}
window.addEventListener('resize', onWindowResize);

function animate(){
  requestAnimationFrame(animate);
  if(!started) { renderer.render(scene, cars.length? cars[0].camera : new THREE.PerspectiveCamera()); return; }

  if(!raceOver){
    cars.forEach(updateCar);
  }
  cars.forEach(updateCamera);

  updateHUD();

  const w = window.innerWidth, h = window.innerHeight;
  const halfW = w/2, halfH = h/2;
  const viewports = [
    {x:0, y:halfH, w:halfW, h:halfH},        // top-left  -> player1
    {x:halfW, y:halfH, w:halfW, h:halfH},    // top-right -> player2
    {x:0, y:0, w:halfW, h:halfH},            // bottom-left -> player3
    {x:halfW, y:0, w:halfW, h:halfH},        // bottom-right -> player4
  ];

  renderer.setScissorTest(true);
  cars.forEach((car,i)=>{
    const vp = viewports[i];
    renderer.setViewport(vp.x, vp.y, vp.w, vp.h);
    renderer.setScissor(vp.x, vp.y, vp.w, vp.h);
    car.camera.aspect = vp.w/vp.h;
    car.camera.updateProjectionMatrix();
    renderer.render(scene, car.camera);
  });
  renderer.setScissorTest(false);
}

/* =========================================================
   إدارة المستويات والشاشات
========================================================= */
function startLevel(lvl){
  level = lvl;
  raceOver = false;
  generateTrack(level);
  if(cars.length===0) createCars(); else cars.forEach(c=>scene.add(c.mesh));
  placeCarsAtStart();
  document.getElementById('topBar').classList.remove('hidden');
}

function onLevelWon(winnerCar){
  setTimeout(()=>{
    document.getElementById('finishedLvl').textContent = level;
    const tag = document.getElementById('winnerTag');
    tag.textContent = `🏆 فاز ${winnerCar.def.name}!`;
    tag.style.background = '#'+winnerCar.def.color.toString(16).padStart(6,'0');
    tag.style.color = '#111';

    let scoresText = cars.map(c=>`${c.def.name}: ${Math.min(c.laps,lapsRequired)} لفة`).join(' | ');
    document.getElementById('finalScoresText').textContent = scoresText;

    if(level >= MAX_LEVEL){
      document.getElementById('ultimateWinnerTag').textContent = `آخر بطل: ${winnerCar.def.name} 🎉`;
      document.getElementById('ultimateWinnerTag').style.background = '#'+winnerCar.def.color.toString(16).padStart(6,'0');
      document.getElementById('gameCompleteScreen').classList.remove('hidden');
    } else {
      document.getElementById('levelCompleteScreen').classList.remove('hidden');
    }
  }, 400);
}

document.getElementById('startBtn').addEventListener('click', ()=>{
  document.getElementById('startScreen').classList.add('hidden');
  started = true;
  startLevel(1);
});

document.getElementById('nextLevelBtn').addEventListener('click', ()=>{
  document.getElementById('levelCompleteScreen').classList.add('hidden');
  startLevel(level+1);
});

document.getElementById('restartBtn').addEventListener('click', ()=>{
  document.getElementById('gameCompleteScreen').classList.add('hidden');
  startLevel(1);
});

animate();
</script>
